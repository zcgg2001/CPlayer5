CHKSZ_API_KEY=

# Username/password: npm run build && npm start (loopback SQLite, no providers needed).
# Production: HTTPS AUTH_URL + stable AUTH_SECRET (32+ chars) + D1 or persistent SQLite.
AUTH_URL=
AUTH_SECRET=
# Optional Node database path; default: .local/accounts/accounts.sqlite
ACCOUNTS_SQLITE=
# Set to 1 only behind a trusted reverse proxy that overwrites CF-Connecting-IP.
# Default 0 uses the Node socket address and ignores client-supplied IP headers.
AUTH_TRUST_PROXY=0
# Optional legacy email/SMS/OAuth providers; not required for username/password.
# accounts:dev writes test emails to .local/accounts/last-email.json (loopback only).
# Never set ACCOUNTS_DEV in production.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Optional build-time D1 override. The repository config retains the production ID.
# Forks or separate environments must use their own database ID and AUTH_URL.
CPLAYER_ACCOUNTS_D1_ID=
