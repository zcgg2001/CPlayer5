{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "sh scripts/build_sites.sh",
    "check:build": "python3 scripts/check_build_output.py",
    "smoke:server": "sh scripts/smoke_server.sh",
    "start": "node server.js",
    "serve": "node server.js",
    "test": "python3 -m unittest discover -s tests -v && node --test tests/*.test.js && python3 scripts/check_static_site.py",
    "cf:build": "npm run build && cf build",
    "cf:dev": "npm run build && cf dev",
    "cf:preview": "vite preview",
    "test:worker": "node --test tests/cloudflare-runtime.js",
    "probe:music": "node scripts/probe_music_sources.js",
    "cf:deploy": "npm run cf:build && cf deploy --prebuilt --mode production",
    "cf:check": "npm run cf:build && cf deploy --prebuilt --mode production --dry-run",
    "accounts:dev": "ACCOUNTS_DEV=1 node server.js",
    "accounts:migration": "node scripts/generate_account_migration.js",
    "desktop:dev": "electron desktop",
    "desktop:package": "npm exec --yes --package=node@22.23.4 -- node scripts/package_desktop.js"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.12",
    "@electron/packager": "19.0.1",
    "cf": "1.0.0-beta.28",
    "electron": "45.2.3",
    "miniflare": "5.20261104.0-beta",
    "vite": "8.3.6"
  },
  "dependencies": {
    "better-auth": "1.7.18",
    "cheerio": "1.1.2"
  }
}
